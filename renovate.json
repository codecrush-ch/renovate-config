{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prConcurrentLimit": 5,
  "automerge": false,
  "packageRules": [
    {
      "description": "Nuxt: nur Minor/Patch, kein Major (bleibt auf 3.x)",
      "matchPackageNames": ["nuxt", "@nuxt/**"],
      "allowedVersions": "^3"
    },
    {
      "description": "Vue: an Nuxt 3 angebunden, kein Major",
      "matchPackageNames": ["vue", "vue-router"],
      "allowedVersions": "^3"
    },
    {
      "description": "Major Updates nur nach Freigabe im Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Dev-Dependencies bündeln",
      "matchDepTypes": ["devDependencies"],
      "groupName": "devDependencies"
    },
    {
      "description": "npm/pnpm Updates erst nach 3 Tagen (Stabilität)",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Patch, Minor & Docker-Digests automatisch mergen – Di/Mi/Do um 5 Uhr",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true,
      "schedule": ["at 5:00am on Tuesday, Wednesday, and Thursday"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash",
    "platformAutomerge": true,
    "schedule": ["at 5:00am on Tuesday, Wednesday, and Thursday"]
  }
}