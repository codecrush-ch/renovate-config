{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Europe/Zurich",
  "prConcurrentLimit": 5,
  "automerge": false,
  "packageRules": [
    {
      "description": "Nuxt: nur Minor/Patch, kein Major (bleibt auf 3.x)",
      "matchPackageNames": ["nuxt", "@nuxt/**"],
      "allowedVersions": "^3"
    },
    {
      "description": "Vue: an Nuxt 3 angebunden, kein Major",
      "matchPackageNames": ["vue", "vue-router"],
      "allowedVersions": "^3"
    },
    {
      "description": "Major Updates nur nach Freigabe im Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Dev-Dependencies bündeln",
      "matchDepTypes": ["devDependencies"],
      "groupName": "devDependencies"
    },
    {
      "description": "npm/pnpm Updates erst nach 3 Tagen (Stabilität)",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Patch, Minor & Docker-Digests: Di/Mi/Do-Nacht 23:00–05:59 (Europe/Zurich)",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "ignoreTests": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "schedule": ["* 23 * * 2,3,4", "* 0-5 * * 3,4,5"],
      "automergeSchedule": ["* 23 * * 2,3,4", "* 0-5 * * 3,4,5"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "ignoreTests": true,
    "automergeType": "pr",
    "automergeStrategy": "squash",
    "platformAutomerge": false,
    "schedule": ["* 23 * * 2,3,4", "* 0-5 * * 3,4,5"],
    "automergeSchedule": ["* 23 * * 2,3,4", "* 0-5 * * 3,4,5"]
  }
}
